<Application x:Class="DictaMeeting.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DictaMeeting.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
            <converters:StringToVisibilityConverter x:Key="StringToVisConverter" />
            <converters:StringToVisibilityConverter x:Key="InverseStringToVisConverter" Invert="True" />
            <converters:EqualityToVisibilityConverter x:Key="EqualityToVisConverter" />
            <converters:EqualityToVisibilityConverter x:Key="InverseEqualityToVisConverter" Invert="True" />
            <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
            <converters:NullToVisibilityConverter x:Key="NotNullToVisConverter" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
