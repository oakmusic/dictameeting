  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app.png" />
    <Resource Include="Assets\splash-background.png" />
    <Resource Include="Assets\microphone-icon.png" />
    <Resource Include="Assets\dictameeting-logo.png" />
    <Resource Include="Assets\byaritz-logo.png" />
  </ItemGroup>

</Project>
