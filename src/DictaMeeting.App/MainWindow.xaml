<Window x:Class="DictaMeeting.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DictaMeeting.App.ViewModels"
        xmlns:behaviors="clr-namespace:DictaMeeting.App.Behaviors"
        xmlns:controls="clr-namespace:DictaMeeting.App.Controls"
        xmlns:enums="clr-namespace:DictaMeeting.Meetings.Enums;assembly=DictaMeeting.Meetings"
        xmlns:loc="clr-namespace:DictaMeeting.App.Markup"
        mc:Ignorable="d"
        Title="{loc:Loc App_Title}"
        Icon="Resources/app.ico"
        Height="800" Width="1280"
        MinHeight="576" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgPrimaryBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource MainFontFamily}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="M" Command="{Binding ToggleMuteMicrophoneCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="M" Command="{Binding ToggleMuteMicrophoneCommand}" />
    </Window.InputBindings>

    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <!-- 0: Apple-Style Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Content (Tabs) -->
            <RowDefinition Height="*" />
            <!-- 2: Modern Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================= -->
        <!-- ============================================================= -->
        <!-- 0. APPLE-STYLE TOP NAVIGATION HEADER (2 FILAS)                -->
        <!-- ============================================================= -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1" Padding="20,12,20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Fila Superior: Marca (Icono + Nombre) + Control Idle / Status -->
                    <RowDefinition Height="Auto" />
                    <!-- Fila Inferior: Botón Nueva Reunión (Izq), Pestañas Centradas, Tema + Ajustes (Der) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ================= FILA SUPERIOR ================= -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- DictaMeeting App Icon: Blue background with white microphone in both light and dark themes -->
                        <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentPrimaryBrush}" Margin="0,7,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoMic}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Brand block + controls in a vertical StackPanel -->
                        <StackPanel VerticalAlignment="Center">
                            <!-- Fila de DictaMeeting alineada con versión y estado Idle -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="DictaMeeting"
                                           FontSize="26"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource BrandTitleBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,-1,10,0" />
                                <Border Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersionShortText, FallbackValue='v1.5.2'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                </Border>

                                <!-- Status Pill with pulsing dot (Control Idle) -->
                                <Border CornerRadius="12" Padding="10,4" Background="{DynamicResource BgTertiaryBrush}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStartingMeeting}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding CurrentState}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Firma byAritz alineada al borde izquierdo de DictaMeeting -->
                            <TextBlock Text="byAritz"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource BrandSubtitleBrush}"
                                       HorizontalAlignment="Left"
                                       Margin="0,-4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ================= FILA INFERIOR ================= -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Izquierda: Botón Nueva Reunión (debajo de DictaMeeting) -->
                        <ColumnDefinition Width="*" />
                        <!-- Centro: Pestañas Centradas -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Derecha: Tema + Ajustes -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Izquierda: Botón Desplegable Nueva Reunión / Importar Audio -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}"
                                Height="34"
                                Padding="13,0,10,0"
                                ToolTip="{loc:Loc Nav_NewMeeting_Tooltip}"
                                Click="NewMeetingDropdownButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Placement="Bottom">
                                    <MenuItem Header="{loc:Loc Nav_NewMeeting}" Command="{Binding CreateNewMeetingCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoPlus}" Fill="{DynamicResource AccentPrimaryBrush}" Width="11" Height="11" Stretch="Uniform" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Loc Nav_ImportAudio}" Command="{Binding OpenImportAudioModalCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoUpload}" Fill="{DynamicResource AccentPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{loc:Loc Nav_ImportTranscript}" Command="{Binding OpenImportTranscriptModalCommand}">
                                        <MenuItem.Icon>
                                            <Path Data="{StaticResource GeoDocument}" Fill="{DynamicResource AccentPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-1,0,1">
                                <Path Data="{StaticResource GeoPlus}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Nav_NewMeeting}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Path Data="{StaticResource GeoChevronDown}" Fill="White" Width="8" Height="5" Stretch="Uniform" Margin="7,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Centro: Apple-style Segmented View Switcher (Uniform Width, Centered) -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SegmentBgBrush}" CornerRadius="8" Padding="3">
                        <UniformGrid Rows="1">
                            <!-- Tab 0: Reunión Activa -->
                            <Button Command="{Binding SelectNewMeetingTabCommand}" Cursor="Hand" BorderThickness="0" Padding="16,6">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource GeoMic}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{loc:Loc Nav_Meeting}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNavigationTab}" Value="0">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Tab 1: Historial -->
                            <Button Command="{Binding SelectHistoryTabCommand}" Cursor="Hand" BorderThickness="0" Padding="16,6">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource GeoHistory}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{loc:Loc Nav_History}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedNavigationTab}" Value="1">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </Border>

                    <!-- Derecha: Quick Actions (Theme Switcher + Ajustes Globales) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Theme Toggle Button (Icono Sol / Luna Minimalista Plano) -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ToggleThemeCommand}" Height="34" Width="40" Padding="0" Margin="0,0,8,0" ToolTip="{Binding ThemeToggleToolTip}">
                            <Grid Width="16" Height="16">
                                <!-- Luna Minimalista en Amarillo Cálido (Modo Claro) -->
                                <Path Data="{StaticResource GeoMoon}"
                                      Fill="#F59E0B"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsDarkMode, Converter={StaticResource InverseBoolToVisConverter}}" />
                                <!-- Sol Minimalista en Amarillo Cálido (Modo Oscuro) -->
                                <Path Data="{StaticResource GeoSun}"
                                      Stroke="#FBBF24"
                                      Fill="#FBBF24"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Visibility="{Binding IsDarkMode, Converter={StaticResource BoolToVisConverter}}" />
                            </Grid>
                        </Button>

                        <!-- Botón Ajustes (Sustituye a Modelos y Configurar IA) -->
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenGlobalSettingsCommand}" Height="34" Padding="14,0" ToolTip="{loc:Loc Nav_Settings_Tooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoGear}" Fill="{DynamicResource AccentPrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Nav_Settings}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- 1. MAIN CONTENT PANELS (TAB 0 VS TAB 1)                       -->
        <!-- ============================================================= -->
        <Grid Grid.Row="1">

            <!-- ========================================================= -->
            <!-- VIEW 0: NUEVA REUNIÓN (RECORDING WORKSPACE)               -->
            <!-- ========================================================= -->
            <Grid Visibility="{Binding SelectedNavigationTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <!-- Audio Settings Card -->
                    <RowDefinition Height="Auto" />
                    <!-- Work Area (Participants + Live Transcription) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Configuration & Action Card (Reorganizada con mayor holgura vertical) -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="20,14,20,0" Padding="20,16">
                    <StackPanel>
                        <!-- ============================================================= -->
                        <!-- FRANJA CENTRAL REDISEÑADA (3 SECCIONES FIJAS)                -->
                        <!-- ============================================================= -->
                        <Grid MinHeight="48">
                            <Grid.ColumnDefinitions>
                                <!-- SECCIÓN IZQUIERDA: Título de la reunión y ajustes seleccionados -->
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="16" />
                                <!-- SECCIÓN CENTRAL: Estado y nivel de audio / Reproductor -->
                                <ColumnDefinition Width="Auto" MinWidth="430" />
                                <ColumnDefinition Width="16" />
                                <!-- SECCIÓN DERECHA: Acciones -->
                                <ColumnDefinition Width="Auto" MinWidth="170" />
                            </Grid.ColumnDefinitions>

                            <!-- ================= 1. SECCIÓN IZQUIERDA ================= -->
                            <!-- Título de la reunión + única línea con los parámetros actuales -->
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Fila 0: Título de la reunión (editable) + Carpeta -->
                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                    <!-- Modo Presentación (con icono lápiz y carpeta) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsEditingMeetingTitle, Converter={StaticResource InverseBoolToVisConverter}}">
                                        <TextBlock Text="{Binding MeetingTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Cursor="Hand" TextTrimming="CharacterEllipsis" MaxWidth="380" ToolTip="{loc:Loc Meeting_Title_Edit_Tooltip}" MouseLeftButtonDown="TitleTextBlock_MouseLeftButtonDown" />
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding StartEditMeetingTitleCommand}" Click="EditMeetingTitleButton_Click" IsEnabled="{Binding CanEditMeetingTitle}" Width="28" Height="28" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{loc:Loc Meeting_Title_Edit_Tooltip}">
                                            <Path Data="{StaticResource GeoPencil}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding OpenMeetingFolderCommand}"
                                                Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{loc:Loc Meeting_Folder_Tooltip}">
                                            <Path Data="{StaticResource GeoFolder}" Fill="#F59E0B" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Modo Edición (Input box con foco directo y confirmación) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsEditingMeetingTitle, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBox x:Name="MeetingTitleEditBox" Text="{Binding MeetingTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontSize="15" FontWeight="Bold" Width="300" Height="34" VerticalContentAlignment="Center" ToolTip="{loc:Loc Meeting_Title_Save_Tooltip}" KeyDown="MeetingTitleEditBox_KeyDown" LostFocus="MeetingTitleEditBox_LostFocus" />
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding FinishEditMeetingTitleCommand}" Width="30" Height="30" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="{loc:Loc Meeting_Title_Save_Tooltip}">
                                            <Path Data="{StaticResource GeoCheck}" Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Fila 1: Metadatos de la reunión / Parámetros de grabación -->
                                <Border Grid.Row="1" Margin="0,5,0,0" ClipToBounds="True">
                                    <Grid>
                                        <!-- CASO A: Reunión Histórica / Completada abierta en el workspace -->
                                        <!-- Ej: 25 sep 2026 · 10:00–11:03 · 2 participantes · Completada · Español -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOpenMeetingCompleted, Converter={StaticResource BoolToVisConverter}}">
                                            <Path Data="{StaticResource GeoClock}" Fill="{DynamicResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding OpenMeetingSubtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- CASO B: Parámetros actuales de grabación (Reunión nueva o en vivo) -->
                                        <!-- 5 participantes · Micrófono + Sistema · En vivo (Auto) / Procesado (Auto) · Español -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOpenMeetingCompleted, Converter={StaticResource InverseBoolToVisConverter}}">
                                            <!-- Participantes (Dinámico) -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{loc:Loc Meeting_Header_Participants_Tooltip}">
                                                <Path Data="{StaticResource GeoUsers}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ParticipantsSummaryText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Separador -->
                                            <TextBlock Text="·" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="7,0" VerticalAlignment="Center" />

                                            <!-- Fuentes de audio -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding AudioSourcesToolTip}">
                                                <Path Data="{StaticResource GeoMic}" Fill="{DynamicResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Opacity" Value="1.0" />
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding CaptureMicrophone}" Value="False" />
                                                                        <Condition Binding="{Binding CaptureSystemAudio}" Value="False" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Opacity" Value="0.4" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <!-- Micrófono (Activo / Tachado) -->
                                                <TextBlock Text="{loc:Loc Audio_Mic_Label}" FontSize="11.5" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="Opacity" Value="1.0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CaptureMicrophone}" Value="False">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Separador · -->
                                                <TextBlock Text="·" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="5,0" VerticalAlignment="Center" />

                                                <!-- Sistema (Activo / Tachado) -->
                                                <TextBlock Text="{loc:Loc Audio_System_Label}" FontSize="11.5" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="Opacity" Value="1.0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CaptureSystemAudio}" Value="False">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                    <Setter Property="Opacity" Value="0.55" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Separador -->
                                            <TextBlock Text="·" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="7,0" VerticalAlignment="Center" />

                                            <!-- Modelos -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{loc:Loc Meeting_Header_Models_Tooltip}">
                                                <Path Data="{StaticResource GeoChip}" Stroke="#8B5CF6" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ModelsSummary}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Separador -->
                                            <TextBlock Text="·" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="7,0" VerticalAlignment="Center" />

                                            <!-- Idioma -->
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{loc:Loc Meeting_Header_Language_Tooltip}">
                                                <Path Data="{StaticResource GeoGlobe}" Fill="{DynamicResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LanguageDisplayShort}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ================= 2. SECCIÓN CENTRAL ================= -->
                            <!-- Estado de la reunión, nivel de audio y reproductor integrado -->
                            <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="430" HorizontalAlignment="Center">
                                <!-- ESTADO 1: PREPARADO (Nueva reunión antes de iniciar) -->
                                <Grid Visibility="{Binding IsPreparedNewMeeting, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <!-- Indicador circular y texto "Preparado" -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Espacio flexible intermedio -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Indicador de nivel de audio en reposo -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Indicador Circular "Preparado / Iniciando" + Texto -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStartingMeeting}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStartingMeeting}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="StartingPulseStoryboard">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.6" AutoReverse="True" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="StartingPulseStoryboard" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding PrepStatusTitle}" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PrepStatusSubtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Onda de nivel de audio en reposo -->
                                    <controls:AudioWaveformVisualizer Grid.Column="2"
                                                                      IsResting="True"
                                                                      BarBrush="{DynamicResource BorderSubtleBrush}"
                                                                      BarCount="18"
                                                                      BarWidth="2.8"
                                                                      BarGap="3.2"
                                                                      Height="26"
                                                                      Width="140"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip="{loc:Loc Player_Idle}" />
                                </Grid>

                                <!-- ESTADO 2: GRABANDO (Estado activo) -->
                                <Grid Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <!-- Indicador rojo + Grabando + Cronómetro -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- Espacio flexible intermedio -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Medidores de Micrófono y Audio del Sistema -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Indicador Rojo de Grabación + Texto "Grabando" + Cronómetro -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FEE2E2" VerticalAlignment="Center">
                                            <Ellipse Width="11" Height="11" Fill="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard x:Name="RecordingPulseStoryboard">
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.75" AutoReverse="True" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <StopStoryboard BeginStoryboardName="RecordingPulseStoryboard" />
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{loc:Loc Meeting_Status_Recording}" FontSize="11.5" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DurationText}" FontSize="17" FontWeight="Bold" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Medidores en tiempo real: Micrófono (Azul) + Audio del Sistema (Verde) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Medidor Micrófono (Azul si activo, Rojo si silenciado) -->
                                        <Button Command="{Binding ToggleMuteMicrophoneCommand}"
                                                IsEnabled="{Binding CanMuteMicrophoneDuringRecording}"
                                                ToolTip="{Binding MuteButtonToolTip}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Vertical" Width="105" HorizontalAlignment="Center">
                                                <controls:AudioWaveformVisualizer AudioLevel="{Binding MicLevel}"
                                                                                  BarBrush="#0071E3"
                                                                                  BarCount="14"
                                                                                  BarWidth="2.8"
                                                                                  BarGap="3.0"
                                                                                  Height="26"
                                                                                  HorizontalAlignment="Center"
                                                                                  ToolTip="{Binding MuteButtonToolTip}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                    <!-- Icono Micrófono Activo -->
                                                    <Path Data="{StaticResource GeoMic}" Fill="#0071E3" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                          Visibility="{Binding IsMicrophoneMuted, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    <!-- Icono Micrófono Silenciado -->
                                                    <Path Data="{StaticResource GeoMicMute}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                          Visibility="{Binding IsMicrophoneMuted, Converter={StaticResource BoolToVisConverter}}" />
                                                    <TextBlock Text="{Binding MicrophoneLiveLabelText}" FontSize="11" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMicrophoneMuted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>

                                        <!-- Medidor Audio del Sistema (Verde si activo, Rojo si silenciado) -->
                                        <Button Command="{Binding ToggleMuteSystemAudioCommand}"
                                                IsEnabled="{Binding CanMuteSystemAudioDuringRecording}"
                                                ToolTip="{Binding SystemAudioToolTip}"
                                                Background="Transparent" BorderThickness="0" Padding="0" Margin="14,0,0,0" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Vertical" Width="125" HorizontalAlignment="Center">
                                                <controls:AudioWaveformVisualizer AudioLevel="{Binding SystemLevel}"
                                                                                  BarBrush="#10B981"
                                                                                  BarCount="14"
                                                                                  BarWidth="2.8"
                                                                                  BarGap="3.0"
                                                                                  Height="26"
                                                                                  HorizontalAlignment="Center"
                                                                                  ToolTip="{Binding SystemAudioToolTip}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                    <!-- Icono Audio Sistema Activo -->
                                                    <Path Data="{StaticResource GeoSpeaker}" Fill="#10B981" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                          Visibility="{Binding IsSystemAudioMuted, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    <!-- Icono Audio Sistema Silenciado -->
                                                    <Path Data="{StaticResource GeoSpeakerMute}" Fill="#EF4444" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"
                                                          Visibility="{Binding IsSystemAudioMuted, Converter={StaticResource BoolToVisConverter}}" />
                                                    <TextBlock Text="{Binding SystemAudioLiveLabelText}" FontSize="11" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSystemAudioMuted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ESTADO 3: COMPLETADA / ABIERTA DESDE HISTORIAL -->
                                <Grid Visibility="{Binding IsOpenMeetingCompleted, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" MinWidth="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Indicador Verde + "Reunión Completada" + Duración -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#DCFCE7" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoCheck}" Fill="#16A34A" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{loc:Loc Meeting_Completed_Badge}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DurationText, StringFormat='{}Duración: {0}'}" FontSize="11" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Estado del Audio Capsule (cuando NO hay audio grabado disponible) -->
                                    <Border Grid.Column="2"
                                            Visibility="{Binding HasPlayerAudio, Converter={StaticResource InverseBoolToVisConverter}}"
                                            Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoSpeaker}" Fill="{DynamicResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding OpenMeetingAudioStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Reproductor de Audio Integrado (cuando SÍ hay audio grabado disponible) -->
                                    <Border Grid.Column="2"
                                            Visibility="{Binding HasPlayerAudio, Converter={StaticResource BoolToVisConverter}}"
                                            Background="{DynamicResource BgSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="18"
                                            Padding="4,2,8,2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Botón Play/Pause -->
                                            <Button Style="{StaticResource PlayerPlayPauseButton}"
                                                    Command="{Binding TogglePlayPauseAudioCommand}"
                                                    ToolTip="{Binding AudioPlayPauseButtonToolTip}"
                                                    Margin="0,0,3,0">
                                                <Grid Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoPlay}"
                                                          Fill="White"
                                                          Stretch="Uniform"
                                                          Margin="1.5,0,0,0"
                                                          Visibility="{Binding IsAudioPlaying, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                    <Path Data="{StaticResource GeoPause}"
                                                          Fill="White"
                                                          Stretch="Uniform"
                                                          Visibility="{Binding IsAudioPlaying, Converter={StaticResource BoolToVisConverter}}" />
                                                </Grid>
                                            </Button>

                                            <!-- Botón Retroceder 5 segundos -->
                                            <Button Style="{StaticResource PlayerIconButton}"
                                                    Command="{Binding SkipBackAudioCommand}"
                                                    ToolTip="{loc:Loc Player_Replay5}"
                                                    Margin="0,0,2,0">
                                                <Path Data="{StaticResource GeoReplay5}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" />
                                            </Button>

                                            <!-- Botón Avanzar 5 segundos -->
                                            <Button Style="{StaticResource PlayerIconButton}"
                                                    Command="{Binding SkipForwardAudioCommand}"
                                                    ToolTip="{loc:Loc Player_Forward5}"
                                                    Margin="0,0,6,0">
                                                <Path Data="{StaticResource GeoForward5}" Fill="{DynamicResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" />
                                            </Button>

                                            <!-- Slider de posición de audio -->
                                            <Slider x:Name="AudioProgressSlider"
                                                    Style="{StaticResource ModernAudioSlider}"
                                                    Width="110"
                                                    VerticalAlignment="Center"
                                                    Minimum="0"
                                                    Maximum="{Binding AudioSliderMaximum}"
                                                    Value="{Binding AudioSliderValue}"
                                                    PreviewMouseDown="AudioProgressSlider_PreviewMouseDown"
                                                    PreviewMouseUp="AudioProgressSlider_PreviewMouseUp"
                                                    PreviewMouseMove="AudioProgressSlider_PreviewMouseMove"
                                                    ValueChanged="AudioProgressSlider_ValueChanged"
                                                    ToolTip="{Binding AudioPositionText}"
                                                    Margin="0,0,8,0" />

                                            <!-- Indicador de tiempo: Actual / Total -->
                                            <TextBlock Text="{Binding AudioPositionText}"
                                                       FontSize="11"
                                                       FontFamily="{DynamicResource CodeFontFamily}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       MinWidth="78"
                                                       TextAlignment="Center"
                                                       Margin="0,0,6,0" />

                                            <!-- Separador vertical sutil -->
                                            <Rectangle Width="1" Height="14" Fill="{DynamicResource BorderSubtleBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />

                                            <!-- Botón Mute / Unmute -->
                                            <Button Style="{StaticResource PlayerIconButton}"
                                                    Command="{Binding ToggleMuteAudioCommand}"
                                                    ToolTip="{Binding AudioVolumeToolTip}"
                                                    Margin="0,0,2,0">
                                                <Grid Width="13" Height="13">
                                                    <Path Data="{StaticResource GeoSpeakerMute}"
                                                          Fill="{DynamicResource DangerBrush}"
                                                          Stretch="Uniform"
                                                          Visibility="{Binding IsAudioVolumeZeroOrMuted, Converter={StaticResource BoolToVisConverter}}" />
                                                    <Path Data="{StaticResource GeoSpeaker}"
                                                          Fill="{DynamicResource TextSecondaryBrush}"
                                                          Stretch="Uniform"
                                                          Visibility="{Binding IsAudioVolumeZeroOrMuted, Converter={StaticResource InverseBoolToVisConverter}}" />
                                                </Grid>
                                            </Button>

                                            <!-- Slider de volumen -->
                                            <Slider Style="{StaticResource ModernMiniSlider}"
                                                    Width="42"
                                                    VerticalAlignment="Center"
                                                    Minimum="0.0"
                                                    Maximum="1.0"
                                                    Value="{Binding AudioVolume, Mode=TwoWay}"
                                                    ToolTip="{Binding AudioVolumeToolTip}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- ================= 3. SECCIÓN DERECHA ================= -->
                            <!-- Botones contextuales según estado: Iniciar/Detener para nuevas o Exportar/Reprocesar para completadas -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- MODO A: REUNIÓN NUEVA / EN CURSO -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOpenMeetingCompleted, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <!-- Botón compacto Sliders para "Ajustes de grabación" (sin texto) -->
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenMeetingSettingsCommand}"
                                            IsEnabled="{Binding IsIdle}"
                                            Width="36" Height="36" Padding="0" Margin="0,0,10,0"
                                            ToolTip="{loc:Loc AudioSettings_Title}">
                                        <Path Data="{StaticResource GeoSliders}" Fill="{DynamicResource AccentPrimaryBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Botón Principal: "Iniciar" en Estado Preparado / Inicializando (Azul) -->
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Command="{Binding StartMeetingCommand}"
                                            Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolToVisConverter}}"
                                            IsHitTestVisible="{Binding CanStartMeeting}"
                                            ToolTip="{Binding StartButtonToolTip}"
                                            Height="36" Width="124" Padding="10,0" FontSize="13" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Icono Play normal -->
                                            <Path Data="{StaticResource GeoPlay}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                  Visibility="{Binding IsStartingMeeting, Converter={StaticResource InverseBoolToVisConverter}}" />

                                            <!-- Icono Spinner con rotación continua al inicializar -->
                                            <Path Data="{StaticResource GeoRefresh}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Visibility="{Binding IsStartingMeeting, Converter={StaticResource BoolToVisConverter}}">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                                <Path.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <!-- Texto dinámico: "Iniciar" o "Iniciando..." -->
                                            <TextBlock Text="{Binding StartButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Botón Principal: "Detener" en Estado Grabando (Rojo) -->
                                    <Button Style="{StaticResource DangerButton}"
                                            Command="{Binding StopMeetingCommand}"
                                            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisConverter}}"
                                            IsHitTestVisible="{Binding CanStopMeeting}"
                                            ToolTip="{Binding StopButtonToolTip}"
                                            Height="36" Width="124" Padding="10,0" FontSize="13" FontWeight="Bold">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Icono Stop normal -->
                                            <Path Data="{StaticResource GeoStop}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                  Visibility="{Binding IsStoppingMeeting, Converter={StaticResource InverseBoolToVisConverter}}" />

                                            <!-- Icono Spinner con rotación continua al detener -->
                                            <Path Data="{StaticResource GeoRefresh}" Fill="White" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Visibility="{Binding IsStoppingMeeting, Converter={StaticResource BoolToVisConverter}}">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0" />
                                                </Path.RenderTransform>
                                                <Path.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <!-- Texto dinámico: "Detener" o "Deteniendo..." -->
                                            <TextBlock Text="{Binding StopButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- MODO B: REUNIÓN COMPLETADA (Abierta desde Historial o finalizada) -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsOpenMeetingCompleted, Converter={StaticResource BoolToVisConverter}}">
                                    <!-- Botón Reprocesar Audio (si tiene archivo de audio y no está en post-procesamiento) -->
                                    <Button Style="{StaticResource SecondaryButton}" Height="36" Padding="12,0"
                                            Visibility="{Binding CanReprocessMeeting, Converter={StaticResource BoolToVisConverter}}"
                                            ToolTip="{loc:Loc Meeting_Reprocess_Tooltip}" Click="ReprocessHistoricalMeetingButton_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Loc Common_Auto_Recommended}" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="Auto" />
                                                <Separator />
                                                <MenuItem Header="Qwen3-ASR 0.6B (~950 MB)" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="Qwen3_06B" />
                                                <MenuItem Header="Qwen3-ASR 1.7B (~2.4 GB)" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="Qwen3_17B" />
                                                <Separator />
                                                <MenuItem Header="Whisper Tiny (~75 MB)" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="Tiny" />
                                                <MenuItem Header="Whisper Base (~145 MB)" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="Base" />
                                                <MenuItem Header="Whisper Small (~480 MB)" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="Small" />
                                                <MenuItem Header="Whisper Medium (~1.5 GB)" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="Medium" />
                                                <MenuItem Header="Whisper Large-v3 Turbo (~1.6 GB)" Command="{Binding ReprocessHistoricalMeetingCommand}" CommandParameter="LargeV3Turbo" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoChip}" Stroke="#6366F1" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc Meeting_Reprocess_Button}" VerticalAlignment="Center" FontWeight="Medium" />
                                            <TextBlock Text=" ▾" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Alerta estilo Teams/Meet: Hablando con el micrófono silenciado -->
                        <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                Visibility="{Binding IsSpeakingWhileMutedAlertVisible, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="26" Height="26" CornerRadius="13" Background="#FEE2E2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Path Data="{StaticResource GeoMicMute}" Fill="#DC2626" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc Meeting_Mic_Muted_Alert}" FontSize="13" FontWeight="Bold" Foreground="#991B1B" />
                                        <TextBlock Text="{loc:Loc Meeting_Mic_Muted_Detail}" FontSize="11.5" Foreground="#7F1D1D" Margin="0,1,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleMuteMicrophoneCommand}" Style="{StaticResource DangerButton}" Height="30" Padding="12,0" FontSize="12" Content="{loc:Loc Meeting_Unmute_Button}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Post-Processing Progress Banner -->
                        <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding IsPostProcessing, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding PostProcessingStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PostProcessingProgress, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelPostProcessingCommand}" Style="{StaticResource DangerButton}" Height="24" Padding="8,0" FontSize="11" Visibility="{Binding CanCancelPostProcessing, Converter={StaticResource BoolToVisConverter}}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding PostProcessingProgress}" Maximum="1.0" Height="4" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" />
                            </Grid>
                        </Border>

                        <!-- First-Run Hardware Recommendation Banner -->
                        <Border Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding IsFirstRunOnboardingVisible, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                        <Path Data="{StaticResource GeoSparkle}" Fill="{DynamicResource AccentPrimaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Onboarding_Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FirstRunHardwareSummary}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Content="{loc:Loc Onboarding_Download_Button}" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadInitialModelCommand}" IsEnabled="{Binding IsDownloadingModel, Converter={StaticResource InverseBoolToVisConverter}}" Height="34" Padding="14,0" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenModelManagerCommand}" Height="34" Padding="12,0" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoChip}" Stroke="#6366F1" StrokeThickness="1.4" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc Onboarding_ViewAll_Button}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="{loc:Loc Onboarding_Skip_Button}" Style="{StaticResource GhostButton}" Command="{Binding DismissOnboardingCommand}" Height="34" Padding="10,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Active Model Download Progress Banner -->
                        <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="{Binding IsDownloadingModel, Converter={StaticResource BoolToVisConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding ModelDownloadStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ModelDownloadProgress, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Value="{Binding ModelDownloadProgress}" Maximum="1.0" Height="4" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource SuccessBrush}" BorderThickness="0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Row 1: Workspace Columns (Participants + Live Transcription) -->
                <Grid Grid.Row="1" Margin="20,14,20,14">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Participants Panel (Reducido al 75%: 270) -->
                        <ColumnDefinition Width="270" MinWidth="240" MaxWidth="320" />
                        <!-- Right: Live Transcription & Summary Panel (Gana el espacio liberado) -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Participants Panel (Ocupa toda la altura vertical disponible) -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- Sección Superior: Participantes Reales -->
                                <RowDefinition Height="Auto" />
                                    <!-- Separador sutil -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Sección Inferior: Locutores Detectados -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- SECCIÓN SUPERIOR: PARTICIPANTES DE LA REUNIÓN -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{loc:Loc Participants_Title}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border HorizontalAlignment="Right" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding RealParticipants.Count, StringFormat='{}{0} registrados'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{loc:Loc Participants_Empty}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

                                    <!-- Campo de entrada + Botón Añadir -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding NewRealParticipantName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource ModernTextBox}"
                                                 Height="30" FontSize="12" Padding="8,0"
                                                 ToolTip="{loc:Loc Participants_Add_Placeholder}"
                                                 KeyDown="NewRealParticipantTextBox_KeyDown" />
                                        <Button Grid.Column="1"
                                                Content="{loc:Loc Participants_Add_Button}"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddRealParticipantCommand}"
                                                Height="30" Padding="10,0" Margin="6,0,0,0" FontSize="11" />
                                    </Grid>

                                    <!-- Chips de nombres reales registrados -->
                                    <ScrollViewer MaxHeight="75" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding RealParticipants}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,4,4">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                            <Button Content="✕"
                                                                    Style="{StaticResource GhostButton}"
                                                                    Command="{Binding DataContext.RemoveRealParticipantCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Height="16" Width="16" Padding="0" Margin="4,0,0,0"
                                                                    FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                                                                    ToolTip="{loc:Loc Participants_Delete_Tooltip}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>

                                <!-- SEPARADOR -->
                                <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2,0,10" />

                                <!-- SECCIÓN INFERIOR: LOCUTORES DETECTADOS (SPEAKERS) -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="{loc:Loc Participants_Voices_Title}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="{Binding Participants.Count, StringFormat='{}{0} voces'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{loc:Loc Participants_Voices_Subtitle}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Lista de interlocutores detectados con ComboBox -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Participants}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SpeakerViewModel}">
                                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Avatar Badge -->
                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <!-- Desplegable con nombres reales -->
                                                                <ComboBox ItemsSource="{Binding AvailableOptions}"
                                                                          SelectedItem="{Binding SelectedRealParticipant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Style="{StaticResource SpeakerComboBox}"
                                                                          ToolTip="{loc:Loc Participants_Voice_Select_Tooltip}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <TextBlock Text="{Binding UtteranceCount, StringFormat='{}{0} interv.'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                                                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding SpeakingTimeFormatted}" FontSize="11" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{loc:Loc Participants_Speaking_Time_Tooltip}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                    <!-- LIVE TRANSCRIPTION & SUMMARY SPLIT PANEL (2 COLUMNAS) -->
                    <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Columna Izquierda: Transcripción en vivo -->
                                <ColumnDefinition Width="*" MinWidth="280" />
                                <!-- Separador central con GridSplitter -->
                                <ColumnDefinition Width="14" />
                                <!-- Columna Derecha: Resumen en vivo -->
                                <ColumnDefinition Width="*" MinWidth="280" />
                            </Grid.ColumnDefinitions>

                            <!-- ======================================================== -->
                            <!-- MITAD IZQUIERDA: TRANSCRIPCIÓN EN VIVO                   -->
                            <!-- ======================================================== -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Columna Izquierda: Transcripción -->
                                <Border Grid.Row="0" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" MinHeight="38">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Título dinámico -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Path Data="{StaticResource GeoDocument}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TranscriptHeaderTitle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Acciones en cabecera: Exportar + Acta con IA (Visibles en reunión completada) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding CanExportMeeting, Converter={StaticResource BoolToVisConverter}}">
                                            <!-- Botón Exportar con menú contextual -->
                                            <Button Style="{StaticResource SecondaryButton}"
                                                    Height="30" Padding="10,0" Margin="0,0,8,0"
                                                    ToolTip="{loc:Loc Live_Export_Tooltip}"
                                                    Click="ExportActiveTranscriptButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{loc:Loc Minutes_Format_Markdown}" Command="{Binding ExportMarkdownCommand}">
                                                            <MenuItem.Icon>
                                                                <Path Data="{StaticResource GeoDocument}" Fill="#3B82F6" Width="13" Height="13" Stretch="Uniform" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Loc Minutes_Format_Text}" Command="{Binding ExportPlainTextCommand}">
                                                            <MenuItem.Icon>
                                                                <Path Data="{StaticResource GeoDocument}" Fill="#64748B" Width="13" Height="13" Stretch="Uniform" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{loc:Loc Minutes_Format_Json}" Command="{Binding ExportJsonCommand}">
                                                            <MenuItem.Icon>
                                                                <Path Data="{StaticResource GeoChip}" Stroke="#D97706" StrokeThickness="1.3" Width="13" Height="13" Stretch="Uniform" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoDocument}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Loc Common_Export}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center" />
                                                    <TextBlock Text=" ▾" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="3,0,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Botón Acta con IA (Acción Primaria destacada) -->
                                            <Button Style="{StaticResource AiPrimaryButton}"
                                                    Command="{Binding OpenActaDialogCommand}"
                                                    Height="30" Padding="12,0"
                                                    ToolTip="{loc:Loc Minutes_Generate_Tooltip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoLightning}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Loc Minutes_Generate_Button_Short}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Lista de intervenciones de la transcripción -->
                                <ScrollViewer Grid.Row="1" x:Name="TranscriptScrollViewer" VerticalScrollBarVisibility="Auto" behaviors:SmartScrollBehavior.EnableAutoScroll="True">
                                    <ItemsControl x:Name="TranscriptItemsControl" ItemsSource="{Binding TranscriptSegments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TranscriptSegmentViewModel}">
                                                <Border Style="{StaticResource TranscriptCardStyle}"
                                                        MouseLeftButtonDown="TranscriptCard_MouseLeftButtonDown">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Header: Speaker Name & Time -->
                                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Speaker Pill -->
                                                            <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0"
                                                                    Visibility="{Binding HasSpeakerLabel, Converter={StaticResource BoolToVisConverter}}">
                                                                <TextBlock Text="{Binding SpeakerDisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>

                                                            <!-- Time -->
                                                            <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="11" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- Segment Spoken Text -->
                                                        <TextBlock Grid.Row="1" Text="{Binding Text}" FontSize="13.5" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- SEPARADOR CENTRAL VERTICAL                               -->
                            <!-- ======================================================== -->
                            <Grid Grid.Column="1">
                                <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Fill="{DynamicResource BorderSubtleBrush}" IsHitTestVisible="False" />
                                <GridSplitter Width="14" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="False" Cursor="SizeWE" />
                            </Grid>

                            <!-- ======================================================== -->
                            <!-- MITAD DERECHA: RESUMEN EN VIVO                           -->
                            <!-- ======================================================== -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header Columna Derecha: Segmented Control [ Resumen ] / [ Acta con IA ] -->
                                <Border Grid.Row="0" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" MinHeight="38">
                                    <Grid VerticalAlignment="Center">
                                        <!-- Apple Segmented Control para alternar entre Resumen y Acta en el Workspace -->
                                        <Border HorizontalAlignment="Left" Background="{DynamicResource SegmentBgBrush}" CornerRadius="8" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Pestaña 0: Resumen -->
                                                <Button Command="{Binding SelectWorkspaceRightTab0Command}" Cursor="Hand" BorderThickness="0" Padding="12,5">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <Path Data="{StaticResource GeoSparkle}" Fill="#8B5CF6" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{loc:Loc Summary_Tab}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding WorkspaceRightTab}" Value="0">
                                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Pestaña 1: Acta -->
                                                <Button Command="{Binding SelectWorkspaceRightTab1Command}" Cursor="Hand" BorderThickness="0" Padding="12,5" Margin="4,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Setter Property="FontWeight" Value="Medium" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                <Path Data="{StaticResource GeoLightning}" Fill="#F59E0B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{loc:Loc Minutes_Tab}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding WorkspaceRightTab}" Value="1">
                                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Indicador de IA en actualización -->
                                        <Border Visibility="{Binding IsLiveSummaryGenerating, Converter={StaticResource BoolToVisConverter}}" Background="{DynamicResource AccentLightBrush}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc Common_Updating}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Contenido de la columna de resumen / acta -->
                                <Grid Grid.Row="1">
                                    <!-- SUB-PANEL 0: RESUMEN EN VIVO (llama.cpp) -->
                                    <Grid Visibility="{Binding WorkspaceRightTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}">
                                        <!-- Caso A: Modelo de resumen no descargado todavía -->
                                        <Border Visibility="{Binding IsLiveSummaryModelDownloaded, Converter={StaticResource InverseBoolToVisConverter}}"
                                                Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="18" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                    <Path Data="{StaticResource GeoSparkle}" Fill="#8B5CF6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{loc:Loc Summary_Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="{loc:Loc Summary_Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12" LineHeight="16" />

                                                <Border Background="{DynamicResource BgTertiaryBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc Common_Model_Prefix}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="Qwen2.5-1.5B-Instruct (~986 MB)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Botón de Descarga -->
                                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding DownloadSummaryModelCommand}" IsEnabled="{Binding IsDownloadingSummaryModel, Converter={StaticResource InverseBoolToVisConverter}}" Height="34" Padding="16,0" HorizontalAlignment="Center">
                                                    <TextBlock Text="{loc:Loc Models_Action_Download}" FontWeight="SemiBold" FontSize="11.5" />
                                                </Button>

                                                <!-- Barra de Progreso de Descarga -->
                                                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsDownloadingSummaryModel, Converter={StaticResource BoolToVisConverter}}">
                                                    <ProgressBar Value="{Binding SummaryModelDownloadProgress}" Maximum="1.0" Height="5" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" />
                                                    <TextBlock Text="{Binding SummaryModelDownloadProgress, StringFormat='{}Descargando: {0:P0}'}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Caso B: Modelo descargado y listo -->
                                        <Grid Visibility="{Binding IsLiveSummaryModelDownloaded, Converter={StaticResource BoolToVisConverter}}">
                                            <!-- Placeholder cuando aún no se ha generado ninguna tarjeta -->
                                            <Border Visibility="{Binding LiveSummaryCards.Count, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16">
                                                <StackPanel HorizontalAlignment="Center" MaxWidth="340">
                                                    <TextBlock Text="💡" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                                    <TextBlock Text="{loc:Loc Live_Waiting}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                    <TextBlock Text="{loc:Loc Summary_Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16" Margin="0,0,0,8" />
                                                    <TextBlock Text="{Binding LiveSummaryStatusText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- ScrollViewer con ItemsControl de tarjetas de resumen por tramo -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" behaviors:SmartScrollBehavior.EnableAutoScroll="True"
                                                          Visibility="{Binding LiveSummaryCards.Count, Converter={StaticResource InverseEqualityToVisConverter}, ConverterParameter=0}">
                                                <ItemsControl ItemsSource="{Binding LiveSummaryCards}" Margin="0,0,4,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:LiveSummaryCardViewModel}">
                                                            <Border Background="{DynamicResource TranscriptBubbleBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,10">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                    </Grid.RowDefinitions>

                                                                    <!-- Header de la tarjeta: Rango temporal y estado -->
                                                                    <Grid Grid.Row="0" Margin="0,0,0,7">
                                                                        <!-- Pill de tiempo con GeoSparkle -->
                                                                        <Border HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="{DynamicResource AccentLightBrush}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Data="{StaticResource GeoSparkle}" Fill="#8B5CF6" Width="9" Height="9" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding FormattedTimeRange}" FontSize="11" FontFamily="{DynamicResource CodeFontFamily}" FontWeight="SemiBold" Foreground="#8B5CF6" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Tiempo relativo -->
                                                                        <TextBlock Text="{Binding RelativeTimeString}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <!-- Texto del párrafo de resumen (~50 palabras) -->
                                                                    <TextBlock Grid.Row="1" Text="{Binding Text}" FontSize="13" LineHeight="19" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>

                                    <!-- SUB-PANEL 1: ACTA EJECUTIVA CON IA -->
                                    <Grid Visibility="{Binding WorkspaceRightTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=1}">
                                        <!-- Caso A: Acta aún no redactada -->
                                        <Border Visibility="{Binding HasGeneratedActa, Converter={StaticResource InverseBoolToVisConverter}}"
                                                Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="44" Height="44" CornerRadius="12" Background="#FEF3C7" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                    <Path Data="{StaticResource GeoLightning}" Fill="#D97706" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{loc:Loc Minutes_Title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                <TextBlock Text="{loc:Loc Minutes_Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14" LineHeight="16" />

                                                <!-- Botón Redactar Acta -->
                                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenActaDialogCommand}" Height="36" Padding="18,0" HorizontalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource GeoLightning}" Fill="#FDE047" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc Minutes_Generate_Button}" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Caso B: Acta redactada y lista -->
                                        <Grid Visibility="{Binding HasGeneratedActa, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.RowDefinitions>
                                                <!-- Toolbar de acciones de Acta: Copiar, Guardar, Redactar de nuevo -->
                                                <RowDefinition Height="Auto" />
                                                <!-- Visualizador de Markdown -->
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding CopyActaToClipboardCommand}" Height="28" Padding="8,0" Margin="0,0,6,0" ToolTip="{loc:Loc Minutes_Copy_Tooltip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📋" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc Common_Copy}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Command="{Binding ExportActaMarkdownCommand}" Height="28" Padding="8,0" Margin="0,0,6,0" ToolTip="{loc:Loc Minutes_Save_Md_Tooltip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc Minutes_Save_Md}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenActaDialogCommand}" Height="28" Padding="10,0" ToolTip="{loc:Loc Minutes_Regenerate_Tooltip}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource GeoLightning}" Fill="#FDE047" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc Minutes_Regenerate_Button}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <Border Grid.Row="1" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <TextBox Text="{Binding GeneratedActaMarkdown, Mode=OneWay}"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             BorderThickness="0"
                                                             IsReadOnly="True"
                                                             FontSize="13"
                                                             FontFamily="{DynamicResource MainFontFamily}"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap" />
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================= -->
            <!-- VIEW 1: HISTORIAL DE REUNIONES (PAST SESSIONS BROWSER)    -->
            <!-- ========================================================= -->
            <Grid Visibility="{Binding SelectedNavigationTab, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=1}" Margin="20,14,20,14">
                <Grid.ColumnDefinitions>
                    <!-- Left: Master List (Past meetings) - 25% más ancho (475px) -->
                    <ColumnDefinition Width="475" />
                    <!-- Right: Detail View (Transcript & Acta) -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: PAST MEETINGS LIST -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Search & Controls -->
                            <RowDefinition Height="Auto" />
                            <!-- Meetings List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search & Quick Action Toolbar -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{loc:Loc History_Subtitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Content="{loc:Loc Common_Refresh}" Style="{StaticResource GhostButton}" Command="{Binding RefreshHistoryCommand}" HorizontalAlignment="Right" Height="30" Padding="8,0" FontSize="11" />
                            </Grid>

                            <!-- Search Input -->
                            <TextBox Text="{Binding HistorySearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,8" ToolTip="{loc:Loc History_Search_Placeholder}" />

                            <!-- New Meeting Quick Button -->
                            <Button Content="{loc:Loc History_Quick_New}" Style="{StaticResource SecondaryButton}" Command="{Binding CreateNewMeetingCommand}" Height="34" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Meetings List (sin scroll horizontal, ajustado al ancho del panel) -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding SavedMeetings}" SelectedItem="{Binding SelectedHistoricalMeeting}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <EventSetter Event="MouseDoubleClick" Handler="HistoryListBoxItem_MouseDoubleClick" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="border" HorizontalAlignment="Stretch" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                                        <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MeetingHistoryItemViewModel}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Title & Status Badge -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="5,1" Background="{DynamicResource BgSecondaryBrush}" Visibility="{Binding IsCompleted, Converter={StaticResource InverseBoolToVisConverter}}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProcessingStatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding ProcessingStatusColorHex}" />
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Date & Duration & Participants -->
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding FormattedDuration}" FontSize="11" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                                <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ParticipantsPreviewText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Row 2: Transcript Preview Quote (si existe) -->
                                        <Border Grid.Row="2" Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,6,0,0" Visibility="{Binding TranscriptPreview, Converter={StaticResource StringToVisConverter}}">
                                            <TextBlock Text="{Binding TranscriptPreview, StringFormat='{}“{0}”'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" FontStyle="Italic" LineHeight="15" />
                                        </Border>

                                        <!-- Row 3: Feature Pills + Acción [ Ver reunión ] -->
                                        <Grid Grid.Row="3" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Badges de características a la izquierda -->
                                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0" Background="{DynamicResource BgTertiaryBrush}">
                                                    <TextBlock Text="{loc:Loc History_Pill_Transcript}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0" Background="{DynamicResource AccentLightBrush}" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{loc:Loc History_Pill_Summary}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                </Border>
                                                <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0" Background="#FEF3C7" Visibility="{Binding HasActa, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="{loc:Loc History_Pill_Acta}" FontSize="9.5" FontWeight="Bold" Foreground="#D97706" />
                                                </Border>
                                            </WrapPanel>

                                            <!-- Botón contextual [ Ver reunión ] a la derecha -->
                                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.OpenMeetingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Height="26" Padding="10,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                                    ToolTip="{loc:Loc History_Open_Workspace_Tooltip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoPlay}" Fill="White" Width="8" Height="8" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Loc History_Open_Button}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- RIGHT: HISTORICAL MEETING PREVIEW PANEL -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}">
                    <Grid>
                        <!-- ESTADO CUANDO NO HAY REUNIÓN SELECCIONADA -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedHistoricalMeeting, Converter={StaticResource NullToVisConverter}}">
                            <TextBlock Text="📋" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="{loc:Loc History_Select_Prompt}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="{loc:Loc History_Select_Hint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" LineHeight="17" />
                        </StackPanel>

                        <!-- ESTADO CON REUNIÓN SELECCIONADA -->
                        <Grid Visibility="{Binding SelectedHistoricalMeeting, Converter={StaticResource NotNullToVisConverter}}">
                            <Grid.RowDefinitions>
                                <!-- Header & Quick Actions -->
                                <RowDefinition Height="Auto" />
                                <!-- Scrollable Preview Sections -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Encabezado de la reunión seleccionada + Acciones -->
                            <Border Grid.Row="0" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Fila 0: Título -->
                                    <TextBlock Grid.Row="0" Text="{Binding SelectedHistoricalMeeting.Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

                                    <!-- Fila 1: Metadatos -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding SelectedHistoricalMeeting.FormattedDate}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SelectedHistoricalMeeting.FormattedDuration, StringFormat='{}Duración: {0}'}" FontSize="12" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SelectedHistoricalMeeting.ParticipantsPreviewText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="•" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding SelectedHistoricalMeeting.AudioStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Fila 2: Acciones destacadas [ Ver reunión ] + [ Abrir Carpeta ] -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <!-- Botón Principal Prominente "Ver reunión" -->
                                        <Button Style="{StaticResource PrimaryButton}"
                                                Command="{Binding OpenMeetingCommand}"
                                                CommandParameter="{Binding SelectedHistoricalMeeting}"
                                                Height="38" Padding="18,0" Margin="0,0,10,0" FontSize="13" FontWeight="Bold"
                                                ToolTip="{loc:Loc History_Open_Tooltip}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoPlay}" Fill="White" Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc History_Open_Button}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Botón Abrir Carpeta -->
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding OpenHistoricalMeetingFolderCommand}"
                                                Height="38" Padding="14,0" ToolTip="{loc:Loc Meeting_Folder_Tooltip}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoFolder}" Fill="#F59E0B" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc Common_OpenFolder}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Secciones de vista previa -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">
                                    <!-- SECCIÓN 1: VISTA PREVIA DE TRANSCRIPCIÓN -->
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <TextBlock Text="{loc:Loc History_Preview_Transcript}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Border HorizontalAlignment="Right" Background="{DynamicResource BgTertiaryBrush}" CornerRadius="10" Padding="8,2">
                                                    <TextBlock Text="{Binding SelectedHistoricalMeeting.Meeting.Transcript.Count, StringFormat='{}{0} fragmentos totales'}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Lista de segmentos de vista previa (primeros tramos) -->
                                            <ItemsControl ItemsSource="{Binding SelectedHistoricalMeeting.PreviewSegments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TranscriptSegmentPreviewItem}">
                                                        <Border Background="{DynamicResource TranscriptBubbleBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                    <Border HorizontalAlignment="Left" CornerRadius="4" Padding="5,1" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                                        <TextBlock Text="{Binding SpeakerDisplayName}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10.5" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>

                                                                <TextBlock Grid.Row="1" Text="{Binding Text}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Mensaje cuando no hay transcripción -->
                                            <TextBlock Text="{loc:Loc Live_Interventions_Empty}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic"
                                                       Visibility="{Binding SelectedHistoricalMeeting.PreviewSegments.Count, Converter={StaticResource EqualityToVisConverter}, ConverterParameter=0}" Margin="0,4" />

                                            <!-- Nota de fragmentos restantes -->
                                            <TextBlock Text="{Binding SelectedHistoricalMeeting.RemainingSegmentCountText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- SECCIÓN 2: VISTA PREVIA DE RESUMEN -->
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Path Data="{StaticResource GeoSparkle}" Fill="#8B5CF6" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc History_Preview_Summary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding SelectedHistoricalMeeting.SummaryPreview}" FontSize="12.5" LineHeight="18" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- SECCIÓN 3: ESTADO DEL ACTA -->
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Path Data="{StaticResource GeoLightning}" Fill="#F59E0B" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{loc:Loc Acta_Modal_Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding SelectedHistoricalMeeting.ActaStatusText}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- SECCIÓN 4: CALLOUT INFORMATIVO -->
                                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource GeoPlay}" Fill="{DynamicResource AccentPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Common_Workspace_Meeting}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{loc:Loc History_Detail_Notice}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding OpenMeetingCommand}"
                                                    CommandParameter="{Binding SelectedHistoricalMeeting}"
                                                    Height="32" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold"
                                                    ToolTip="{loc:Loc History_Open_Workspace_Tooltip}">
                                                <TextBlock Text="{loc:Loc History_Open_Arrow_Button}" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================= -->
        <!-- 2. MODERN BOTTOM STATUS BAR                                   -->
        <!-- ============================================================= -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- Barra de progreso con porcentaje en franja inferior durante el procesamiento -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0" Visibility="{Binding IsPostProcessing, Converter={StaticResource BoolToVisConverter}}">
                    <ProgressBar Width="140" Height="6" Value="{Binding PostProcessingProgress, Mode=OneWay}" Minimum="0" Maximum="1" Style="{StaticResource ModernProgressBar}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PostProcessingProgress, StringFormat='{}{0:P0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" MinWidth="34" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc App_Local_Badge}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBlock Text="CPU" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0" />
                    <TextBlock Text="•" FontSize="11" Foreground="{DynamicResource BorderSubtleBrush}" Margin="0,0,14,0" />
                    <TextBlock FontSize="11" VerticalAlignment="Center">
                        <Run Text="{loc:Loc App_Developed_By}" Foreground="{DynamicResource TextMutedBrush}" />
                        <Run Text="Aritz Villodas" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================= -->
        <!-- 2. MODAL OVERLAY: AJUSTES GLOBALES                            -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsGlobalSettingsModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="620" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Options List -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoGear}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseGlobalSettingsCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Options List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Card 1: Modelos Locales -->
                            <Button Style="{StaticResource SettingCardButton}" Command="{Binding OpenModelManagerFromSettingsCommand}" ToolTip="{loc:Loc Settings_Card_Models_Tooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoChip}" Stroke="#6366F1" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Información -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Loc Settings_Card_Models_Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                        <TextBlock Text="{loc:Loc Settings_Card_Models_Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Indicador Chevron -->
                                    <Path Grid.Column="2" Data="{StaticResource GeoChevronRight}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                </Grid>
                            </Button>

                            <!-- Card 2: Proveedores de IA -->
                            <Button Style="{StaticResource SettingCardButton}" Command="{Binding OpenAiConfigFromSettingsCommand}" ToolTip="{loc:Loc Settings_Card_Ai_Tooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoSparkle}" Fill="#8B5CF6" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Información -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{loc:Loc Settings_Card_Ai_Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource CardItemBgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasConfiguredApiKey}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ApiKeyStatusText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" ToolTip="{Binding ApiKeyStatusText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_Card_Ai_Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Indicador Chevron -->
                                    <Path Grid.Column="2" Data="{StaticResource GeoChevronRight}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                </Grid>
                            </Button>

                            <!-- Card 3: Vocabulario y Palabras Clave -->
                            <Button Style="{StaticResource SettingCardButton}" Command="{Binding OpenVocabularyFromSettingsCommand}" ToolTip="{loc:Loc Settings_Card_Vocab_Tooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="📖" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Información -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{loc:Loc Settings_Card_Vocab_Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VocabularyCount, StringFormat='{}{0} términos'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_Card_Vocab_Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Indicador Chevron -->
                                    <Path Grid.Column="2" Data="{StaticResource GeoChevronRight}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                </Grid>
                            </Button>

                            <!-- Card 4: Privacidad y Grabación -->
                            <Button Style="{StaticResource SettingCardButton}" Command="{Binding OpenPrivacySettingsFromSettingsCommand}" ToolTip="{loc:Loc Settings_Card_Privacy_Tooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoShield}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Información -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{loc:Loc Settings_Card_Privacy_Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Settings_Card_Privacy_Badge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_Card_Privacy_Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Indicador Chevron -->
                                    <Path Grid.Column="2" Data="{StaticResource GeoChevronRight}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                </Grid>
                            </Button>

                            <!-- Card 5: Sistema -->
                            <Button Style="{StaticResource SettingCardButton}" Command="{Binding OpenSystemSettingsFromSettingsCommand}" ToolTip="{loc:Loc Settings_Card_System_Tooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoSliders}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Información -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <TextBlock Text="{loc:Loc Settings_Card_System_Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border CornerRadius="4" Padding="8,3" Margin="10,0,0,0" Background="{DynamicResource CardItemBgBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SystemSummaryBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{loc:Loc Settings_Card_System_Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Indicador Chevron -->
                                    <Path Grid.Column="2" Data="{StaticResource GeoChevronRight}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                </Grid>
                            </Button>

                            <!-- Card 6: Acerca de -->
                            <Button Style="{StaticResource SettingCardButton}" Command="{Binding OpenAboutFromSettingsCommand}" ToolTip="{loc:Loc Settings_Card_About_Tooltip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icono -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoInfo}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Información -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Loc Settings_Card_About_Title}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                        <TextBlock Text="{loc:Loc Settings_Card_About_Subtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Indicador Chevron -->
                                    <Path Grid.Column="2" Data="{StaticResource GeoChevronRight}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc About_Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="{loc:Loc Common_Close}" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Command="{Binding CloseGlobalSettingsCommand}" Height="36" Padding="20,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 2B. MODAL OVERLAY: SISTEMA (TEMA E IDIOMA)                    -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsSystemSettingsModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Body -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSliders}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc System_Modal_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseSystemSettingsModalCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Body -->
                    <StackPanel Grid.Row="1">
                        <!-- Sección 1: TEMA -->
                        <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc System_Section_Theme_Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />

                                <!-- Segmented Control Tema -->
                                <Border Background="{DynamicResource SegmentBgBrush}" CornerRadius="8" Padding="3">
                                    <UniformGrid Rows="1">
                                        <!-- Modo Claro -->
                                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Light" Cursor="Hand" BorderThickness="0" Padding="0,8">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="FontWeight" Value="Medium" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource GeoSun}" Width="14" Height="14" Stretch="Uniform" Stroke="#F59E0B" Fill="#F59E0B" StrokeThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{loc:Loc System_Theme_Light}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="False">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Modo Oscuro -->
                                        <Button Command="{Binding SelectThemeCommand}" CommandParameter="Dark" Cursor="Hand" BorderThickness="0" Padding="0,8">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="FontWeight" Value="Medium" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <Path Data="{StaticResource GeoMoon}" Width="14" Height="14" Stretch="Uniform" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{loc:Loc System_Theme_Dark}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Sección 2: IDIOMA -->
                        <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc System_Section_Language_Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />

                                <!-- Segmented Control Idioma -->
                                <Border Background="{DynamicResource SegmentBgBrush}" CornerRadius="8" Padding="3">
                                    <UniformGrid Rows="1">
                                        <!-- Español -->
                                        <Button Command="{Binding SelectLanguageCommand}" CommandParameter="es" Cursor="Hand" BorderThickness="0" Padding="0,8">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="FontWeight" Value="Medium" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="🇪🇸" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{loc:Loc System_Language_Spanish}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding UiLanguage}" Value="es">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- English -->
                                        <Button Command="{Binding SelectLanguageCommand}" CommandParameter="en" Cursor="Hand" BorderThickness="0" Padding="0,8">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Setter Property="FontWeight" Value="Medium" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="🇬🇧" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{loc:Loc System_Language_English}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding UiLanguage}" Value="en">
                                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="Bold" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>
                                </Border>

                                <!-- Separación de UI y ASR explicada al usuario -->
                                <TextBlock Text="{loc:Loc System_Language_Hint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="2,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Command="{Binding CloseSystemSettingsModalCommand}" Content="{loc:Loc Common_Accept}" Padding="20,0" Height="36" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 3. MODAL OVERLAY: GESTOR DE MODELOS DE TRANSCRIPCIÓN LOCAL        -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsModelManagerModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="700" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Models Storage Location -->
                        <RowDefinition Height="Auto" />
                        <!-- Hardware recommendation callout -->
                        <RowDefinition Height="Auto" />
                        <!-- Catalog List -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧠" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Models_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseModelManagerCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Models Storage Location Card -->
                    <Border Grid.Row="1" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Title and Badge -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{loc:Loc Models_Location_Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ModelsDirectoryTypeBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Current Path -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CurrentModelsDirectory}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,4" ToolTip="{Binding CurrentModelsDirectory}" />

                            <!-- Helper Text -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Models_Location_Desc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                            <!-- Inaccessible Warning Banner -->
                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0" Visibility="{Binding IsModelsDirectoryAccessible, Converter={StaticResource InverseBoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚠️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ModelsDirectoryWarningMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Change Location Button -->
                            <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Content="{loc:Loc Models_Change_Folder}" Style="{StaticResource SecondaryButton}" Command="{Binding ChangeModelsDirectoryCommand}" Height="34" Padding="14,0" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Hardware Recommendation Info Callout -->
                    <Border Grid.Row="2" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Models_Recommended_Subtitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding FirstRunHardwareSummary}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Catalog List of all Models -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ModelCatalog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WhisperModelCardViewModel}">
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Model Information -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />

                                                    <!-- Engine Badge -->
                                                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EngineBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>

                                                    <!-- Hardware Recommended Badge -->
                                                    <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisConverter}}" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Loc Models_Recommended_Badge}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                                                <!-- Download Progress Bar (when downloading) -->
                                                <ProgressBar Value="{Binding DownloadProgress}" Maximum="1.0" Height="4" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisConverter}}" />
                                            </StackPanel>

                                            <!-- Actions: Status / Download / Delete -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Downloaded Badge + Delete Button -->
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisConverter}}">
                                                    <Border Background="{DynamicResource SuccessBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                                        <TextBlock Text="{loc:Loc Models_Status_Downloaded}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                                    </Border>
                                                    <Button Content="🗑" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteModelCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Height="34" Padding="10,0" ToolTip="{loc:Loc Models_Action_Delete_Tooltip}" />
                                                </StackPanel>

                                                <!-- Not Downloaded: Download Button -->
                                                <Button Content="{Binding FormattedSize, StringFormat='{}⬇ Descargar ({0})'}" Style="{StaticResource PrimaryButton}" Command="{Binding DataContext.DownloadModelCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBoolToVisConverter}}" Height="34" Padding="14,0" FontSize="12" Visibility="{Binding IsDownloaded, Converter={StaticResource InverseBoolToVisConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <TextBlock Text="{loc:Loc Models_Footer_Note}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CloseModelManagerCommand}" Height="36" Padding="14,0" Visibility="{Binding IsOpenedFromGlobalSettings, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeoChevronLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="7" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc Settings_Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="{loc:Loc Common_Close}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseModelManagerCommand}" Height="36" Padding="16,0" Visibility="{Binding IsOpenedFromGlobalSettings, Converter={StaticResource InverseBoolToVisConverter}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 4. MODAL OVERLAY: CONFIGURACIÓN OPENROUTER AI                 -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsAiConfigModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="620" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🤖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc AiConfig_Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseAiConfigCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                        </Grid>

                        <!-- Selector de Proveedor -->
                        <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc AiConfig_Provider_Label}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="OpenRouter" GroupName="AiProviderGroup" IsChecked="{Binding IsOpenRouterConfigSelected, Mode=OneWay}" Click="OpenRouterRadio_Click" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                    <RadioButton Content="{loc:Loc AiConfig_Provider_Custom}" GroupName="AiProviderGroup" IsChecked="{Binding IsCustomServerConfigSelected, Mode=OneWay}" Click="CustomServerRadio_Click" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- PANEL 1: OPENROUTER -->
                        <StackPanel Visibility="{Binding IsOpenRouterConfigSelected, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Privacy / Info Callout -->
                            <Border Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc AiConfig_Subtitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc AiConfig_Callout_Privacy}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- API Key Status Indicator -->
                            <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock Text="{Binding ApiKeyStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="openrouter.ai" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- API Key Input -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{loc:Loc AiConfig_ApiKey_Placeholder}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <PasswordBox x:Name="OpenRouterPasswordBox" PasswordChanged="OpenRouterPasswordBox_PasswordChanged" Style="{StaticResource ModernPasswordBox}" Height="40" ToolTip="{loc:Loc AiConfig_OpenRouter_Key_Tooltip}" />
                                <TextBlock Text="{loc:Loc AiConfig_ApiKey_Help}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Test Result Indicator -->
                            <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14" Visibility="{Binding OpenRouterConnectionTestResult, Converter={StaticResource StringToVisConverter}}">
                                <TextBlock Text="{Binding OpenRouterConnectionTestResult}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpenRouterTestSuccess}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Buttons OpenRouter -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="{loc:Loc AiConfig_Save_Key_Button}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveApiKeyCommand}" Height="36" Padding="14,0" Margin="0,0,8,0" />
                                    <Button Content="{loc:Loc AiConfig_Delete_Button}" Style="{StaticResource DangerButton}" Command="{Binding DeleteApiKeyCommand}" IsEnabled="{Binding HasConfiguredApiKey}" Height="36" Padding="12,0" Margin="0,0,8,0" />
                                    <Button Content="{loc:Loc AiConfig_Test_Button}" Style="{StaticResource SecondaryButton}" Command="{Binding TestOpenRouterConnectionCommand}" IsEnabled="{Binding IsOpenRouterTestingConnection, Converter={StaticResource InverseBoolToVisConverter}}" Height="36" Padding="14,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- PANEL 2: SERVIDOR PERSONALIZADO -->
                        <StackPanel Visibility="{Binding IsCustomServerConfigSelected, Converter={StaticResource BoolToVisConverter}}">
                            <!-- Privacy / Info Callout -->
                            <Border Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc AiConfig_Subtitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc AiConfig_Callout_Privacy}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Endpoint Input -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc AiConfig_Endpoint_Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CustomAiEndpoint, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40" ToolTip="{loc:Loc AiConfig_Custom_Endpoint_Placeholder}" />
                                <TextBlock Text="{loc:Loc AiConfig_Custom_Endpoint_Label}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Model Input -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc AiConfig_Model_Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CustomAiModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Height="40" ToolTip="{loc:Loc AiConfig_Custom_Model_Placeholder}" />
                                <TextBlock Text="{loc:Loc AiConfig_Custom_Model_Label}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- API Key Input -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="{loc:Loc AiConfig_ApiKey_Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CustomServerApiKeyStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <PasswordBox x:Name="CustomServerPasswordBox" PasswordChanged="CustomServerPasswordBox_PasswordChanged" Style="{StaticResource ModernPasswordBox}" Height="40" ToolTip="{loc:Loc AiConfig_Custom_Key_Tooltip}" />
                                <TextBlock Text="{loc:Loc AiConfig_Custom_Key_Help}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Test Result Indicator -->
                            <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14" Visibility="{Binding CustomServerConnectionTestResult, Converter={StaticResource StringToVisConverter}}">
                                <TextBlock Text="{Binding CustomServerConnectionTestResult}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomServerTestSuccess}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Buttons Custom Server -->
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="{loc:Loc AiConfig_Save_Config_Button}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCustomServerConfigCommand}" Height="36" Padding="14,0" Margin="0,0,8,0" />
                                    <Button Content="{loc:Loc AiConfig_Delete_Key_Button}" Style="{StaticResource DangerButton}" Command="{Binding DeleteCustomServerApiKeyCommand}" IsEnabled="{Binding HasConfiguredCustomServerApiKey}" Height="36" Padding="12,0" Margin="0,0,8,0" />
                                    <Button Content="{loc:Loc AiConfig_Test_Button}" Style="{StaticResource SecondaryButton}" Command="{Binding TestCustomServerConnectionCommand}" IsEnabled="{Binding IsCustomServerTestingConnection, Converter={StaticResource InverseBoolToVisConverter}}" Height="36" Padding="14,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Common Footer: Close / Back -->
                        <Grid Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding CloseAiConfigCommand}" Height="36" Padding="14,0" Visibility="{Binding IsOpenedFromGlobalSettings, Converter={StaticResource BoolToVisConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoChevronLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="7" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc Settings_Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="{loc:Loc Common_Close}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseAiConfigCommand}" Height="36" Padding="16,0" Visibility="{Binding IsOpenedFromGlobalSettings, Converter={StaticResource InverseBoolToVisConverter}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 4b. MODAL OVERLAY: GESTOR DE VOCABULARIO Y PALABRAS CLAVE     -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsVocabularyModalOpen, Converter={StaticResource BoolToVisConverter}}" IsVisibleChanged="VocabularyModal_IsVisibleChanged">
            <Border Width="820" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Subtitle -->
                        <RowDefinition Height="Auto" />
                        <!-- Add / Edit Form Card -->
                        <RowDefinition Height="Auto" />
                        <!-- Toolbar (Search + Import/Export) -->
                        <RowDefinition Height="Auto" />
                        <!-- Terms List -->
                        <RowDefinition Height="*" />
                        <!-- Status Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 1. Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Vocab_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border CornerRadius="4" Padding="8,2" Margin="14,0,0,0" Background="{DynamicResource AccentLightBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding VocabularyCount, StringFormat='{}{0} términos registrados'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseVocabularyModalCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- 2. Subtitle -->
                    <TextBlock Grid.Row="1" Text="{loc:Loc Vocab_Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <!-- 3. Formulario para añadir / editar término -->
                    <Border Grid.Row="2" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{loc:Loc Vocab_Section_Add}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Input 1: Palabra oficial -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc Vocab_Field_Word}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="VocabularyNewWordTextBox"
                                             Text="{Binding VocabularyManager.NewWord, UpdateSourceTrigger=PropertyChanged}"
                                             Height="34" Padding="8,4" VerticalContentAlignment="Center"
                                             ToolTip="{loc:Loc Vocab_Field_Word_Tooltip}"
                                             KeyDown="VocabularyTextBox_KeyDown" />
                                </StackPanel>

                                <!-- Input 2: Variantes fonéticas autogeneradas -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Vocab_Field_Variants}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="VocabularyNewWordAliasesTextBox"
                                             Text="{Binding VocabularyManager.NewWordAliasesText, UpdateSourceTrigger=PropertyChanged}"
                                             Height="34" Padding="8,4" VerticalContentAlignment="Center"
                                             ToolTip="{loc:Loc Vocab_Field_Variants_Tooltip}"
                                             KeyDown="VocabularyTextBox_KeyDown" />
                                </StackPanel>

                                <!-- Botón Guardar -->
                                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding VocabularyManager.AddOrUpdateTermCommand}" Height="34" Padding="16,0" VerticalAlignment="Bottom" ToolTip="{loc:Loc Vocab_Save_Tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc Common_Save}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 4. Toolbar: Buscador y Botones de Importación/Exportación -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Buscador -->
                        <TextBox Grid.Column="0" Text="{Binding VocabularyManager.SearchQuery, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,12,0" ToolTip="{loc:Loc Vocab_Search_Placeholder}" />

                        <!-- Acciones Importar / Exportar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding VocabularyManager.ImportFromFileCommand}" Height="32" Padding="12,0" Margin="0,0,8,0" ToolTip="{loc:Loc Vocab_Import_Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Vocab_Import_Json}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding VocabularyManager.ExportToFileCommand}" Height="32" Padding="12,0" ToolTip="{loc:Loc Vocab_Export_Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc Vocab_Export_Json}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 5. Lista de Términos -->
                    <Border Grid.Row="4" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="6" MinHeight="160" MaxHeight="250">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding VocabularyManager.FilteredTerms}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,3" Padding="10,8" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Palabra Oficial -->
                                                <TextBlock Grid.Column="0" Text="{Binding Word}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <!-- Variantes Fonéticas -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                                    <TextBlock Text="{loc:Loc Vocab_Variants_Prefix}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AliasesDisplayText}" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Acciones Fila: Editar y Eliminar -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Height="26" Padding="6,0" Margin="0,0,4,0" ToolTip="{loc:Loc Vocab_Edit_Tooltip}" Command="{Binding DataContext.VocabularyManager.EditTermCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="✏️" FontSize="11" />
                                                    </Button>
                                                    <Button Style="{StaticResource DangerButton}" Height="26" Padding="6,0" ToolTip="{loc:Loc Vocab_Delete_Tooltip}" Command="{Binding DataContext.VocabularyManager.RemoveTermCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                        <TextBlock Text="🗑" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 6. Status Message -->
                    <TextBlock Grid.Row="5" Text="{Binding VocabularyManager.StatusMessage}" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,6,0,6" Visibility="{Binding VocabularyManager.HasStatusMessage, Converter={StaticResource BoolToVisConverter}}" />

                    <!-- 7. Footer -->
                    <Grid Grid.Row="6" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Vocab_Tip_Auto}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Command="{Binding CloseVocabularyModalCommand}" Height="36" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoChevronLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="7" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Settings_Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 4c. MODAL OVERLAY: PRIVACIDAD Y GRABACIÓN                     -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsPrivacySettingsModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="620" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Subtitle -->
                        <RowDefinition Height="Auto" />
                        <!-- Body -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoShield}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Privacy_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding ClosePrivacySettingsModalCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Subtitle -->
                    <TextBlock Grid.Row="1" Text="{loc:Loc Settings_Card_Privacy_Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16" />

                    <!-- Body Content -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Card 1: Opción de Recordatorio previo -->
                            <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ShowRecordingNotice}" Content="{loc:Loc Privacy_Notice_Toggle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <TextBlock Text="{loc:Loc Notice_Reminder}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="24,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Estado del flujo de datos y procesamiento -->
                            <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Privacy_Section_Storage}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                    <!-- Audio -->
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Privacy_Item_Recording}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Audio}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentLightBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Local_Badge}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Transcripción -->
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Privacy_Item_Transcript}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Transcript}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentLightBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Local_Badge}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Diarización -->
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Privacy_Item_Diarization}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Diarization}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource AccentLightBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Local_Badge}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Generación de Acta -->
                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{loc:Loc Privacy_Item_Minutes}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Ai}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,10,6" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{loc:Loc Privacy_Storage_AiProvider_Label}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding PrivacyAiProviderSummary}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Loc Privacy_Storage_Provider_Badge}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Nota de Responsabilidad -->
                            <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,6">
                                <TextBlock Text="{loc:Loc Privacy_Disclaimer}"
                                           FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="17" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Command="{Binding ClosePrivacySettingsModalCommand}" Height="36" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoChevronLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="7" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Settings_Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 4d. MODAL OVERLAY: ACERCA DE DICTAMEETING                     -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsAboutModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="640" MaxHeight="660" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Body -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AccentLightBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoInfo}" Fill="{DynamicResource AccentPrimaryBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc About_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseAboutModalCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Body Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Identidad y Autor Card -->
                            <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="DictaMeeting" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="{loc:Loc App_Tagline}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                                    <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,10" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc About_Created_By}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Aritz Villodas" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Loc About_Project}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <TextBlock Grid.Column="1" Text="{loc:Loc About_Description}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Tecnologías Card -->
                            <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc About_Tech_Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                    <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- .NET / C# -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text=".NET / C#" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc About_Tech_App}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />

                                            <!-- WPF -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="WPF" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc About_Tech_UI}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />

                                            <!-- ONNX Runtime -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ONNX Runtime" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Loc About_Tech_Inference}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />

                                            <!-- Whisper -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Whisper" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc About_Tech_Speech}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />

                                            <!-- Qwen3-ASR -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Qwen3-ASR" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Loc About_Tech_Qwen}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />

                                            <!-- Silero VAD -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Silero VAD" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:Loc About_Tech_VAD}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />

                                            <!-- pyannote -->
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="pyannote" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{loc:Loc About_Tech_Diarization}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />

                                            <!-- NAudio -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="NAudio" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{loc:Loc About_Tech_AudioCapture}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Open Source y Enlace GitHub -->
                            <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Loc About_Tech_License_Notice}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding AppVersionText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- Botón GitHub -->
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding OpenGitHubUrlCommand}" Height="34" Padding="14,0" VerticalAlignment="Center" ToolTip="{loc:Loc About_GitHub_Tooltip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoGitHub}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="GitHub" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc About_Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Command="{Binding CloseAboutModalCommand}" Height="36" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoChevronLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="7" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Settings_Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 5. MODAL OVERLAY: GENERADOR Y VISOR DE ACTA                   -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsActaModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="920" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Acta_Modal_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActaTokensUsedText}" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseActaDialogCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Options Bar (Exclusivamente los 2 Modelos Permitidos) -->
                    <Border Grid.Row="1" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Dropdowns Row -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <!-- Model Selector -->
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="14" />
                                    <!-- Language Selector -->
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <!-- Detail Level -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- AI Model Selector (OpenRouter or Custom Server) -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc AiConfig_Model_Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableAiModels}" SelectedItem="{Binding SelectedAiModel}" DisplayMemberPath="DisplayName" Height="36" />
                                </StackPanel>

                                <!-- Language -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Acta_Language_Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox SelectedValue="{Binding SelectedActaLanguage}" SelectedValuePath="Tag" Height="36">
                                        <ComboBoxItem Content="{loc:Loc System_Language_Spanish}" Tag="{x:Static enums:LanguageMode.Spanish}" IsSelected="True" />
                                        <ComboBoxItem Content="{loc:Loc System_Language_English}" Tag="{x:Static enums:LanguageMode.English}" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Detail -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{loc:Loc Acta_Level_Detail}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding AvailableDetailLevels}" SelectedItem="{Binding SelectedDetailLevel}" Height="36" />
                                </StackPanel>
                            </Grid>

                            <!-- Checkboxes & Generate Button -->
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IncludeParticipants}" Content="{loc:Loc Acta_Check_Participants}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                                    <CheckBox IsChecked="{Binding IncludeDecisions}" Content="{loc:Loc Acta_Check_Decisions}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                                    <CheckBox IsChecked="{Binding IncludeActionItems}" Content="{loc:Loc Acta_Check_Actions}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                                    <CheckBox IsChecked="{Binding IncludePendingQuestions}" Content="{loc:Loc Acta_Check_Pending}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" />
                                    <CheckBox IsChecked="{Binding IsImpersonalActa}" Content="{loc:Loc Acta_Check_Impersonal}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" ToolTip="{loc:Loc Minutes_Impersonal_Tooltip}" />
                                </StackPanel>

                                <Button Content="{loc:Loc Acta_Button_Generate}" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateActaCommand}" IsEnabled="{Binding IsGeneratingActa, Converter={StaticResource InverseBoolToVisConverter}}" HorizontalAlignment="Right" Height="36" Padding="18,0" FontSize="12.5" />
                            </Grid>

                            <!-- Generation Progress Indicator -->
                            <Border Grid.Row="2" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="{Binding IsGeneratingActa, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActaGenerationStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" />
                                </StackPanel>
                            </Border>

                            <!-- Error Message -->
                            <Border Grid.Row="3" Background="#FEE2E2" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="{Binding ActaErrorMessage, Converter={StaticResource StringToVisConverter}}">
                                <TextBlock Text="{Binding ActaErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Generated Markdown Viewer -->
                    <Border Grid.Row="2" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding GeneratedActaMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="13" FontFamily="{DynamicResource MainFontFamily}" AcceptsReturn="True" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="{loc:Loc Acta_Button_Copy}" Style="{StaticResource SecondaryButton}" Command="{Binding CopyActaToClipboardCommand}" IsEnabled="{Binding HasGeneratedActa}" Height="36" Padding="14,0" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Acta_Button_SaveMd}" Style="{StaticResource SecondaryButton}" Command="{Binding ExportActaMarkdownCommand}" IsEnabled="{Binding HasGeneratedActa}" Height="36" Padding="14,0" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Acta_Button_Folder}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenMeetingFolderCommand}" Height="36" Padding="14,0" />
                        </StackPanel>
                        <Button Content="{loc:Loc Common_Close}" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Command="{Binding CloseActaDialogCommand}" Height="36" Padding="16,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 6. MODAL OVERLAY: AJUSTES DE REUNIÓN Y MODELOS                -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsMeetingSettingsModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="680" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Body -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoSliders}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc AudioSettings_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseMeetingSettingsCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Audio Devices Card -->
                            <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeoMic}" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource AccentPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{loc:Loc AudioSettings_InputDevices}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- Refresh Audio Devices Button -->
                                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAudioDevicesCommand}" Height="34" Padding="12,0" Margin="0,0,8,0" ToolTip="{loc:Loc AudioSettings_Refresh_Tooltip}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeoRefresh}" Fill="{DynamicResource AccentPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{loc:Loc AudioSettings_Refresh}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Test Audio Button inside Settings Modal -->
                                            <Button Command="{Binding ToggleAudioMonitoringCommand}" Height="34" Padding="14,0" ToolTip="{loc:Loc AudioSettings_TestAudio_Tooltip}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource GeoPlay}" Fill="#10B981" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{loc:Loc AudioSettings_TestAudio}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMonitoringAudio}" Value="True">
                                                                <Setter Property="Content">
                                                                    <Setter.Value>
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <Path Data="{StaticResource GeoStop}" Fill="White" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{loc:Loc AudioSettings_TestAudio_Stop}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Two-column Audio Input Devices -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Mic Input Configuration -->
                                        <Border Grid.Column="0" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{loc:Loc AudioSettings_Mic}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                <CheckBox Grid.Row="1" IsChecked="{Binding CaptureMicrophone}" Content="{loc:Loc AudioSettings_Mic_Capture}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                                <ComboBox Grid.Row="2" ItemsSource="{Binding AvailableMicrophones}" SelectedItem="{Binding SelectedMicrophone}" IsEnabled="{Binding CaptureMicrophone}" DisplayMemberPath="Name" Height="38" ToolTip="{loc:Loc AudioSettings_Mic_Tooltip}" />
                                                <ProgressBar Grid.Row="3" Value="{Binding MicLevel, Mode=OneWay}" Minimum="0" Maximum="1" Style="{StaticResource VuMeterBar}" Margin="0,8,0,0" ToolTip="{loc:Loc AudioSettings_MicLevel_Tooltip}" />
                                            </Grid>
                                        </Border>

                                        <!-- System Audio Loopback Configuration -->
                                        <Border Grid.Column="2" Background="{DynamicResource BgInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{loc:Loc AudioSettings_SystemAudio}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                <CheckBox Grid.Row="1" IsChecked="{Binding CaptureSystemAudio}" Content="{loc:Loc AudioSettings_SystemAudio_Capture}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                                <ComboBox Grid.Row="2" ItemsSource="{Binding AvailableSystemDevices}" SelectedItem="{Binding SelectedSystemDevice}" IsEnabled="{Binding CaptureSystemAudio}" DisplayMemberPath="Name" Height="38" ToolTip="{loc:Loc AudioSettings_SystemAudio_Tooltip}" />
                                                <ProgressBar Grid.Row="3" Value="{Binding SystemLevel, Mode=OneWay}" Minimum="0" Maximum="1" Style="{StaticResource VuMeterBar}" Margin="0,8,0,0" ToolTip="{loc:Loc AudioSettings_SystemLevel_Tooltip}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Models & Language Card -->
                            <Border Style="{StaticResource SubCardPanel}" Margin="0,0,0,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoChip}" Stroke="#6366F1" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{loc:Loc AudioSettings_ModelsAndLang}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Live Model -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{loc:Loc AudioSettings_LiveModel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding AvailableLiveModels}" SelectedItem="{Binding SelectedLiveModel}" DisplayMemberPath="DisplayName" Height="38" ToolTip="{loc:Loc AudioSettings_LiveModel_Tooltip}" />
                                            <TextBlock Text="{Binding SelectedLiveModel.Description}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Final Model -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc AudioSettings_FinalModel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                            <ComboBox ItemsSource="{Binding AvailableFinalModels}" SelectedItem="{Binding SelectedFinalModel}" DisplayMemberPath="DisplayName" Height="38" ToolTip="{loc:Loc AudioSettings_FinalModel_Tooltip}" />
                                            <TextBlock Text="{Binding SelectedFinalModel.Description}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Language Selector -->
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="{loc:Loc AudioSettings_Language}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="DisplayName" Height="38" ToolTip="{loc:Loc AudioSettings_Language_Tooltip}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc AudioSettings_AutoSave_Note}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="{loc:Loc Common_Accept}" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Command="{Binding CloseMeetingSettingsCommand}" Height="36" Padding="20,0" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 7. MODAL OVERLAY: IMPORTAR ARCHIVO DE AUDIO                   -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsImportAudioModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Body / Drag & Drop -->
                        <RowDefinition Height="*" />
                        <!-- Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoUpload}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Import_Audio_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseImportAudioModalCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Body -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{loc:Loc Import_Audio_Desc}"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <!-- Drag & Drop Zone -->
                        <Border x:Name="AudioDropBorder"
                                Background="{DynamicResource BgInputBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="20,24"
                                MinHeight="170"
                                AllowDrop="True"
                                DragOver="AudioDropZone_DragOver"
                                DragLeave="AudioDropZone_DragLeave"
                                Drop="AudioDropZone_Drop"
                                MouseLeftButtonDown="AudioDropZone_MouseLeftButtonDown"
                                Cursor="Hand">
                            <Grid>
                                <!-- Estado 1: Ningún archivo seleccionado -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasSelectedImportAudioFile, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <Border Width="50" Height="50" CornerRadius="25" Background="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Path Data="{StaticResource GeoUpload}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{loc:Loc Import_Audio_Drop}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="{loc:Loc Import_Audio_OrBrowse}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                    <Button Content="{loc:Loc Common_Browse}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseAudioFileCommand}"
                                            Height="32" Padding="16,0"
                                            HorizontalAlignment="Center"
                                            FontSize="12" />
                                </StackPanel>

                                <!-- Estado 2: Archivo seleccionado listo para importar -->
                                <Grid Visibility="{Binding HasSelectedImportAudioFile, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoSpeaker}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedImportAudioFileName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding SelectedImportAudioFileSizeText}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding SelectedImportAudioDurationText}" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Medium" Visibility="{Binding SelectedImportAudioDurationText, Converter={StaticResource StringToVisConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{loc:Loc Import_Audio_Change}" Style="{StaticResource GhostButton}" Command="{Binding BrowseAudioFileCommand}" VerticalAlignment="Center" FontSize="12" Height="30" Padding="8,0" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Error Message if invalid format -->
                        <Border Background="#FEE2E2" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="{Binding ImportAudioErrorMessage, Converter={StaticResource StringToVisConverter}}">
                            <TextBlock Text="{Binding ImportAudioErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <!-- Supported Formats Badges -->
                        <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc Import_Audio_Supported}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="MP3" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="WAV" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="M4A" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="AAC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="WMA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="FLAC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="OGG" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,0,2">
                                        <TextBlock Text="MP4" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Config preview note -->
                        <TextBlock Text="{loc:Loc Import_Audio_Note}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,10,0,0" />
                    </StackPanel>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Loc Common_Cancel}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CloseImportAudioModalCommand}"
                                    Height="36" Padding="18,0" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Import_Audio_Button}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ConfirmImportAudioCommand}"
                                    IsEnabled="{Binding HasSelectedImportAudioFile}"
                                    Height="36" Padding="20,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 8. MODAL OVERLAY: IMPORTAR TRANSCRIPCIÓN                      -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsImportTranscriptModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoDocument}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Import_Transcript_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding CloseImportTranscriptModalCommand}" Style="{StaticResource GhostButton}" FontSize="16" Height="30" Padding="6,0" />
                    </Grid>

                    <!-- Body -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{loc:Loc Import_Transcript_Desc}"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <!-- Drag &amp; Drop Zone -->
                        <Border x:Name="TranscriptDropBorder"
                                Background="{DynamicResource BgInputBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="20,24"
                                MinHeight="170"
                                AllowDrop="True"
                                DragOver="TranscriptDropZone_DragOver"
                                DragLeave="TranscriptDropZone_DragLeave"
                                Drop="TranscriptDropZone_Drop"
                                MouseLeftButtonDown="TranscriptDropZone_MouseLeftButtonDown"
                                Cursor="Hand">
                            <Grid>
                                <!-- Estado 1: Ningún archivo seleccionado -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasSelectedImportTranscriptFile, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <Border Width="50" Height="50" CornerRadius="25" Background="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <Path Data="{StaticResource GeoDocument}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{loc:Loc Import_Transcript_Drop}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <TextBlock Text="{loc:Loc Import_Audio_OrBrowse}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                    <Button Content="{loc:Loc Common_Browse}"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding BrowseTranscriptFileCommand}"
                                            Height="32" Padding="16,0"
                                            HorizontalAlignment="Center"
                                            FontSize="12" />
                                </StackPanel>

                                <!-- Estado 2: Archivo seleccionado listo para importar -->
                                <Grid Visibility="{Binding HasSelectedImportTranscriptFile, Converter={StaticResource BoolToVisConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource GeoDocument}" Fill="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedImportTranscriptFileName}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SelectedImportTranscriptFileSizeText}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{loc:Loc Common_Change}" Style="{StaticResource GhostButton}" Command="{Binding BrowseTranscriptFileCommand}" VerticalAlignment="Center" FontSize="12" Height="30" Padding="8,0" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Error Message -->
                        <Border Background="#FEE2E2" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="{Binding ImportTranscriptErrorMessage, Converter={StaticResource StringToVisConverter}}">
                            <TextBlock Text="{Binding ImportTranscriptErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <!-- Supported Formats Badges -->
                        <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc Import_Audio_Supported}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="TXT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="MD" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="SRT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="VTT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,6,2">
                                        <TextBlock Text="LOG" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,0,2">
                                        <TextBlock Text="RST · ORG · …" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Border>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Info note -->
                        <TextBlock Text="{loc:Loc Import_Transcript_Notice}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="2,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:Loc Common_Cancel}"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CloseImportTranscriptModalCommand}"
                                    Height="36" Padding="18,0" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Import_Transcript_Button}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ConfirmImportTranscriptCommand}"
                                    IsEnabled="{Binding HasSelectedImportTranscriptFile}"
                                    Height="36" Padding="20,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 9. MODAL OVERLAY: RECORDATORIO PREVIO A LA GRABACIÓN          -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsRecordingNoticeModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header con Icono de Micrófono -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource GeoMic}" Fill="{DynamicResource AccentPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{loc:Loc Notice_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Mensaje informativo -->
                    <TextBlock Text="{loc:Loc Notice_Text}"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24" />

                    <!-- Botones Cancelar y Comenzar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="{loc:Loc Notice_Cancel}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelRecordingNoticeCommand}" Height="36" Padding="18,0" Margin="0,0,10,0" />
                        <Button Grid.Column="2" Content="{loc:Loc Notice_Start}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmRecordingNoticeAndStartCommand}" Height="36" Padding="22,0" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 10. MODAL OVERLAY: ASISTENTE DE PRIMER ARRANQUE (MODELOS BÁSICOS) -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsFirstRunModelsModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.30" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Location Selector -->
                        <RowDefinition Height="Auto" />
                        <!-- Models List -->
                        <RowDefinition Height="Auto" />
                        <!-- Progress / Error / Actions -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeoChip}" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Onboarding_Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc Onboarding_Subtitle}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Location Selector -->
                    <Border Grid.Row="1" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="{loc:Loc Onboarding_Location_Label}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ModelsDirectoryTypeBadge}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentModelsDirectory}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentModelsDirectory}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{loc:Loc Models_Change_Folder}" Style="{StaticResource GhostButton}" Command="{Binding ChangeModelsDirectoryCommand}" Height="30" Padding="10,0" FontSize="11.5" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Models List -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding FirstRunModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FirstRunModelItemViewModel}">
                                <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Model Title and Role -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Role}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Size and Status Badge -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- Downloaded state (green badge) -->
                                            <Border Background="{DynamicResource SuccessBrush}" CornerRadius="6" Padding="8,4" Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{loc:Loc Onboarding_Available_Badge}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                            </Border>

                                            <!-- Pending / Waiting / In-progress text badge when not yet completed -->
                                            <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Visibility="{Binding IsDownloaded, Converter={StaticResource InverseBoolToVisConverter}}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Progress Bar & details when downloading -->
                                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ProgressBar Grid.Row="0" Value="{Binding DownloadProgress}" Maximum="1.0" Height="4" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" />
                                            <TextBlock Grid.Row="1" Text="{Binding ProgressText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bottom Section: Progress, Errors, and Buttons -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <!-- Error Banner (if error occurred) -->
                        <Border Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16" Visibility="{Binding FirstRunHasError, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Onboarding_Attention_Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding FirstRunErrorMessage}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- Total Progress Bar (when downloading) -->
                        <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16" Visibility="{Binding IsFirstRunDownloading, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding FirstRunStatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FirstRunTotalProgressPercentText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Value="{Binding FirstRunTotalProgress}" Maximum="1.0" Height="6" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <!-- Buttons Row: Idle state (not downloading) -->
                        <Grid Visibility="{Binding IsFirstRunDownloading, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Ahora no (Left) -->
                            <Button Grid.Column="0" Content="{loc:Loc Onboarding_Skip_Button}" Style="{StaticResource GhostButton}" Command="{Binding DismissFirstRunModalCommand}" Height="38" Padding="14,0" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" ToolTip="{loc:Loc Onboarding_Skip_Tooltip}" />

                            <!-- Right actions: Descargar or Reintentar / Continuar -->
                            <!-- If error: Reintentar and Continuar -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding FirstRunHasError, Converter={StaticResource BoolToVisConverter}}">
                                <Button Content="{loc:Loc Onboarding_Continue_Button}" Style="{StaticResource SecondaryButton}" Command="{Binding CloseFirstRunModalAfterErrorCommand}" Height="38" Padding="16,0" Margin="0,0,8,0" />
                                <Button Content="{loc:Loc Onboarding_Retry_Button}" Style="{StaticResource PrimaryButton}" Command="{Binding StartFirstRunDownloadsCommand}" Height="38" Padding="18,0" FontWeight="SemiBold" />
                            </StackPanel>

                            <!-- If no error: Descargar modelos button -->
                            <Button Grid.Column="2" Content="{Binding FirstRunDownloadButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding StartFirstRunDownloadsCommand}" Height="38" Padding="22,0" FontWeight="SemiBold" FontSize="13" Visibility="{Binding FirstRunHasError, Converter={StaticResource InverseBoolToVisConverter}}" />
                        </Grid>

                        <!-- Buttons Row: Downloading state -->
                        <Grid Visibility="{Binding IsFirstRunDownloading, Converter={StaticResource BoolToVisConverter}}">
                            <Button Content="{loc:Loc Models_Action_Cancel}" Style="{StaticResource DangerButton}" Command="{Binding CancelFirstRunDownloadsCommand}" Height="36" Padding="18,0" HorizontalAlignment="Right" FontSize="12.5" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================= -->
        <!-- 11. MODAL OVERLAY: CONFIRMACIÓN Y MIGRACIÓN DE MODELOS        -->
        <!-- ============================================================= -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ModalOverlayBrush}" Visibility="{Binding IsMoveModelsModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource BgSecondaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.30" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource AccentLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Loc Migrate_Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc Migrate_Subtitle}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Details Card: Source & Destination -->
                    <Border Grid.Row="1" Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Source -->
                            <TextBlock Text="{loc:Loc Migrate_Current_Location}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding MoveModelsSourceDirectory}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MoveModelsSourceDirectory}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding MoveModelsFoundCount, StringFormat='{}{0} modelos'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                                <TextBlock Text="{Binding MoveModelsFoundFormattedSize, StringFormat='{}Tamaño total: {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Separator Background="{DynamicResource BorderSubtleBrush}" Height="1" Margin="0,2,0,10" />

                            <!-- Destination -->
                            <TextBlock Text="{loc:Loc Migrate_New_Location}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding MoveModelsTargetDirectory}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MoveModelsTargetDirectory}" />
                        </StackPanel>
                    </Border>

                    <!-- Progress or Error Area -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <!-- Error Banner (if error occurred) -->
                        <Border Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="{Binding MoveModelsHasError, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Migrate_Error_Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding MoveModelsErrorMessage}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- Migration In-Progress Box -->
                        <Border Background="{DynamicResource CardItemBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Visibility="{Binding IsMovingModels, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding MovingModelsCurrentOperation}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MovingModelsTotalProgressPercentText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Value="{Binding MovingModelsTotalProgress}" Maximum="1.0" Height="6" Background="{DynamicResource BgTertiaryBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" BorderThickness="0" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding MovingModelsCurrentItem}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Actions Row -->
                    <Grid Grid.Row="3">
                        <!-- Idle State (Not moving) -->
                        <Grid Visibility="{Binding IsMovingModels, Converter={StaticResource InverseBoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Cancelar -->
                            <Button Grid.Column="0" Content="{loc:Loc Common_Cancel}" Style="{StaticResource GhostButton}" Command="{Binding CancelMoveModelsCommand}" Height="38" Padding="14,0" FontSize="12.5" />

                            <!-- Right: Cambiar sin mover & Mover modelos -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{loc:Loc Migrate_Keep_Button}" Style="{StaticResource SecondaryButton}" Command="{Binding ConfirmChangeWithoutMoveCommand}" Height="38" Padding="14,0" FontSize="12" Margin="0,0,8,0" ToolTip="{loc:Loc Migrate_Keep_Tooltip}" />
                                <Button Content="{loc:Loc Migrate_Move_Button}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmMoveModelsCommand}" Height="38" Padding="18,0" FontWeight="SemiBold" FontSize="12.5" />
                            </StackPanel>
                        </Grid>

                        <!-- Moving State -->
                        <Grid Visibility="{Binding IsMovingModels, Converter={StaticResource BoolToVisConverter}}">
                            <Button Content="{loc:Loc Migrate_Cancel_Button}" Style="{StaticResource DangerButton}" Command="{Binding CancelMovingModelsExecutionCommand}" Height="36" Padding="18,0" HorizontalAlignment="Right" FontSize="12.5" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
